# Where the deployed app lives
BASE_URL=https://collab-board-coral.vercel.app
API_URL=https://collab-board-api.onrender.com

# From your CollabBoard Clerk dashboard (Configure > API Keys)
# Test in dev mode first (pk_test_.../sk_test_...) before pointing at production keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# A dedicated test account (Email + Password strategy must be enabled in Clerk
# for this to work — social-login-only apps can't sign in headlessly).
# Create this user once in the Clerk dashboard for the test project, not your real account.
TEST_USER_EMAIL=collabboard.tester@example.com
TEST_USER_PASSWORD=change-me-strong-password
